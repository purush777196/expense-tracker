# ==============================================================================
# Expense Tracker - EditorConfig Configuration
# http://EditorConfig.org
# ==============================================================================

root = true

# Top-level defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Java source code (Spring Boot backend)
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# Python source code (FastAPI AI service) - PEP 8 standard
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# JavaScript, JSX, JSON (React frontend)
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2
max_line_length = 100

# CSS, SCSS, HTML
[*.{css,scss,html}]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 120

# YAML configurations (Docker, GitHub Actions, application.yml)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# SQL & Flyway Migrations
[*.sql]
indent_style = space
indent_size = 4

# Shell scripts & Batch
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf

# Maven XML POMs
[pom.xml]
indent_style = space
indent_size = 4
