# ==============================================================================
# Expense Tracker Backend - Environment Variables Template
# Copy this file to .env and configure with your local secrets.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# JWT Security Configuration
# The signing key must be a base64 or plaintext secret with at least 256 bits (32+ characters)
JWT_SECRET=replace_with_a_secure_minimum_32_character_secret_key_for_hmac256
# Access token validity: 15 minutes (900000 ms)
JWT_EXPIRATION_MS=900000
# Refresh token validity: 7 days (604800000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Microservice Internal URL
AI_SERVICE_URL=http://localhost:8000
