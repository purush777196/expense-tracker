#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for Unix / POSIX
# ----------------------------------------------------------------------------

set -e

if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

if [ -f "$HOME/.m2/wrapper/dists/apache-maven-3.9.16/bin/mvn" ]; then
    exec "$HOME/.m2/wrapper/dists/apache-maven-3.9.16/bin/mvn" "$@"
fi

echo "[ERROR] Maven command not found in PATH." >&2
exit 1
