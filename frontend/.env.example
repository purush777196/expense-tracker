# ==============================================================================
# Expense Tracker Frontend - Environment Configuration Template
# ==============================================================================

# Backend API base URL
# In local development with Vite proxy, use /api/v1
# In standalone production, use full URL (e.g., https://api.expensetracker.local/api/v1)
VITE_API_BASE_URL=/api/v1

# Application branding
VITE_APP_NAME="Expense Tracker"

# Preview mode indicator
VITE_ENABLE_PREVIEW_MODE=false

